{
  "name": "hwpc-marketing-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI+华为PC营销软文智能体",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/contracts",
    "fixtures",
    "packages/data",
    "packages/agent",
    "apps/server",
    "apps/web",
    "scenes"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev -w @hwpc/server",
    "dev:web": "npm run dev -w @hwpc/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build -w @hwpc/web",
    "sync:creative": "node scripts/sync-creative.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "concurrently": "9.2.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
