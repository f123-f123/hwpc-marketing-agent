# 复制为 .env 后填写。.env 已被 .gitignore 忽略，切勿提交真实凭证。

# ---- 服务端 ----
PORT=8787
# 允许的前端来源（开发时 Vite 默认 5173）
CORS_ORIGIN=http://localhost:5173

# ---- 资料来源模式 ----
# auto：有 ima 凭证用 ima，否则有本地目录用 local，否则 mock
# mock / local / ima：强制指定。mock 数据会在所有响应里标记 mock
DATA_SOURCE_MODE=auto

# ---- ima OpenAPI（变量名与赛题手册一致）----
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
# 本进程最多调用 ima OpenAPI 的次数（共享知识库调用次数有限）；用完后停止请求 ima，auto 模式回到本地资料。默认 300
IMA_CALL_BUDGET=300

# ---- 本地资料（解压后的知识库根目录，建议放在 code/local-data/ 下）----
LOCAL_KB_DIR=

# ---- 模型服务（OpenAI 兼容 chat/completions 接口）----
# 留空则模型状态显示 not_configured，工作流只能使用 mock 模型
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=60000

# ---- 联网检索（可选）----
# 体验页补图、答疑补充参考。目前支持 Tavily（https://tavily.com）请求格式；只填 Key 即启用，留空则只用本地知识库。
WEB_SEARCH_PROVIDER=tavily
# 可选：代理或兼容 Tavily 请求格式的自建地址（填根地址会自动补 /search）；留空用 https://api.tavily.com/search
WEB_SEARCH_BASE_URL=
WEB_SEARCH_API_KEY=

# ---- 登录与密钥（门店推文模块）----
# 主密钥：签发登录令牌、加密平台密钥（公众号 AppSecret 等）。至少 16 位随机字符串。
# 留空时首次启动会在 apps/server/.runtime/marketing/master.key 生成一份；公网部署必须显式设置并妥善保管。
AUTH_SECRET=
# 首次启动（还没有任何账号）时创建的初始口令，登录后请立即修改
HQ_INITIAL_PASSWORD=hq123456
STORE_INITIAL_PASSWORD=store123456
# 通过 HTTPS 访问时设为 true（登录 Cookie 加 Secure）
COOKIE_SECURE=false

# ---- 出站代理（可选）----
# 本机代理只接管部分程序、Node 访问模型服务 / ima 超时（核验报告显示“模型服务无法连接”）时启用。
# 服务端加载 .env 后调用 http.setGlobalProxyFromEnv 生效；Node 版本不支持时启动日志会提示，改为启动前设置环境变量。
NODE_USE_ENV_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
